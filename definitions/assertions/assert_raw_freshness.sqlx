config {
  type: "assertion",
  description: "Fails if source ingestion has been stalled for longer than vars.freshnessHours. Equivalent to dbt's source freshness (warn 2h / error 6h).",
  tags: ["assertion", "source"]
}

js {
  const thresholdHours = Number(dataform.projectConfig.vars.freshnessHours);
  const scanDays = Math.ceil(thresholdHours / 24) + 1;
}

select
    max(timestamp(ingested_at)) as last_ingested_at,
    timestamp_diff(
        current_timestamp(),
        max(timestamp(ingested_at)),
        hour
    ) as hours_since_last_ingest,
from
    ${ref("ext__events")}
where true
    and dt >= date_sub(current_date(), interval ${scanDays} day)
having
    last_ingested_at is null
    or hours_since_last_ingest > ${thresholdHours}
